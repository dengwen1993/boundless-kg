# ============================================================
# kg_engine — environment template (NO real secrets)
# ============================================================
# Copy to `.env` and fill in real values; `.env` is git-ignored.
#
# Per ENGINEERING_PLAN.md §1.1, secrets must NEVER be hardcoded in source.
# ============================================================

# --- LLM provider keys ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_MODEL=MiniMax-M3-512k

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_CHAT=deepseek-v4-flash
DEEPSEEK_MODEL_V4=deepseek-v4-pro

# --- Mock vs live LLM ---
# mock = use AsyncLLMClient mock (default; safe for tests + local dev)
# minimax / deepseek / openai = real provider
# KG_LLM_PROVIDER controls the agent chat layer (see src/agent/orchestrator.py).
# KG_GENERATION_LLM_PROVIDER controls business flows (graph-generation
# pipeline, note service, resource classifier). When unset it falls back
# to KG_LLM_PROVIDER so existing setups keep working.
KG_LLM_PROVIDER=minimax
KG_GENERATION_LLM_PROVIDER=deepseek
# Note generation: pin to the faster chat-tier model (deepseek-v4-flash)
# so single note calls return in ~1-2s instead of >30s on deepseek-v4-pro.
KG_NOTE_LLM_PROVIDER=deepseek-chat
# Bump per-request HTTP timeout to give reasoning models room.
KG_LLM_TIMEOUT_SEC=600
KG_LLM_REASONING_EFFORT=low
# --- Search backend (DuckDuckGo primary + mmx + Bocha fallback) ---
# DuckDuckGo proxy: leave empty to auto-detect system proxy at startup.
# Set explicitly if auto-detection fails, e.g. DDG_PROXY=http://127.0.0.1:7897
DDG_PROXY=
MMX_API_KEY=
MMX_REGION=cn
MMX_PROXY=
# Bocha AI Search (博查搜索) — https://open.bochaai.com/
# POST https://api.bochaai.com/v1/web-search  (Authorization: Bearer ...)
# Leave BOCHA_API_KEY empty to skip Bocha in the fallback chain.
BOCHA_API_KEY=
BOCHA_ENDPOINT=https://api.bochaai.com/v1/web-search
BOCHA_PROXY=
BOCHA_TIMEOUT_SEC=15
BOCHA_COUNT=10
# Adaptive backend ordering (see src/infrastructure/search/preference.py).
# KG_SEARCH_ADAPTIVE=true → promote whichever backend last returned results
# and quarantine backends that fail. Set to false to use the fixed chain.
KG_SEARCH_ADAPTIVE=true
# How long to quarantine a failed backend (seconds). Default 6h.
# Failures and their errors are appended to
# <KG_AGENT_MEMORY_DIR>/search_preference.json for ops to review.
KG_SEARCH_QUARANTINE_SEC=21600
KG_SEARCH_MAX_CONCURRENCY=5
KG_SEARCH_RATE_LIMIT_MS=300

# --- Workspace layout (relative paths resolve against CWD) ---
# KG_WORKSPACE_DIR is the parent directory that holds BOTH the curated
# knowledge (KG_KB_ROOT below) and the operational data the agent
# generates at runtime:
#   <KG_WORKSPACE_DIR>/
#   ├── AGENTS.md          ← single source of truth for curated memory
#   │                        (injected into SystemMessage at build time)
#   ├── knowledge_bases/   ← domain data lives here (set KG_KB_ROOT to this)
#   ├── .agent_memory/     ← conversations/ + tmp/  (NOT AGENTS.md any more)
#   ├── _pipeline/         ← pipeline state.json (transient)
#   └── _staging/          ← file upload hand-off area
# Local dev defaults to the in-repo ``./workspace`` directory.
# Container deployments override both this and KG_KB_ROOT to point at
# the bind-mounted path inside the image (see docker-compose.yml).
KG_WORKSPACE_DIR=./workspace
KG_KB_ROOT=./workspace/knowledge_bases

# --- API server ---
KG_API_HOST=0.0.0.0
KG_API_PORT=8888
# JSON list of CORS allowed origins (pydantic-settings parses list[...] as JSON)
KG_API_CORS_ORIGINS=["http://localhost:5175"]

# --- Agent runtime ---
KG_AGENT_RECURSION_LIMIT=250
KG_AGENT_THREAD_ID=default
# Agent memory directory (relative to KG_WORKSPACE_DIR or absolute).
# Houses conversation logs + transient ``tmp/`` files (auto-cleaned
# every 24h, 7-day retention). It no longer holds AGENTS.md — that's
# a sibling file under KG_WORKSPACE_DIR itself; see the layout block
# above and ``src/agent/system_prompt.py:compose_system_prompt``.
KG_AGENT_MEMORY_DIR=.agent_memory
# Prompt-card middleware — per-turn dynamic prompt enhancement.
# When true, the agent injects behavior rules from loaded cards into
# the system prompt based on trigger conditions (instead of hardcoding
# all rules in the system prompt). See ``src/agent/cards/``.
KG_AGENT_CARDS_ENABLED=false
# Shell sandbox tool — exposes ``kg_shell_exec`` to the agent for
# running shell commands in a sandboxed environment. Disable for
# production deployments that don't need shell access.
# See ``src/agent/shell_sandbox.py``.
KG_AGENT_SHELL_ENABLED=true
# Disable workspace/AGENTS.md injection into the SystemMessage.
# Accepts 1 / true / yes / on. Default unset (injection is ON).
# Set to 1 when the workspace is read-only, when debugging a stale
# cached prompt, or when ops wants the static SYSTEM_PROMPT only.
# See ``src/agent/system_prompt.py:_is_workspace_memory_disabled``.
# KG_AGENT_WORKSPACE_MEM_DISABLED=1

# --- Logging ---
KG_LOG_LEVEL=INFO
KG_LOG_FORMAT=json

# --- FalkorDB (graph database for hybrid search) ---
# When disabled, graph store operations are skipped (graceful degradation
# — the system falls back to BM25-only keyword search).
# In Docker, set KG_FALKORDB_HOST=falkordb to point at the companion service.
KG_FALKORDB_ENABLED=true
KG_FALKORDB_HOST=localhost
KG_FALKORDB_PORT=6379
# KG_FALKORDB_PASSWORD=your_password_here
# Graph name prefix — each domain gets its own graph: kg_{domain}
KG_FALKORDB_GRAPH_PREFIX=kg_
# Where the /api/associations/* endpoints read from:
#   auto     → FalkorDB when reachable, else fallback to associations.json
#   falkordb → always FalkorDB (empty shell on failure)
#   json     → always associations.json (legacy behaviour)
KG_ASSOCIATIONS_SOURCE=auto

# --- Embedding API (for vector semantic search) ---
# OpenAI-compatible /v1/embeddings endpoint.
# Supported providers:
#   - DeepSeek: https://api.deepseek.com
#   - Aliyun DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
#   - OpenAI: https://api.openai.com
# Fill in KG_EMBEDDING_API_KEY with your provider's key.
# If left empty, falls back to DEEPSEEK_API_KEY.
# When no key is available, vector search is skipped (BM25-only mode).
KG_EMBEDDING_PROVIDER=api
KG_EMBEDDING_API_KEY=
KG_EMBEDDING_BASE_URL=https://api.deepseek.com
KG_EMBEDDING_MODEL=text-embedding-v1
KG_EMBEDDING_DIM=1024
KG_EMBEDDING_BATCH_SIZE=32

# --- Hybrid search weights (BM25 + Vector fusion) ---
# RRF formula: score = w_bm25/(60+rank_bm25) + w_vector/(60+rank_vector)
# Default: BM25=0.4, Vector=0.6 (semantic bias).
# For keyword-heavy queries, increase BM25 weight.
KG_SEARCH_BM25_WEIGHT=0.4
KG_SEARCH_VECTOR_WEIGHT=0.6
KG_SEARCH_DEFAULT_TOP_K=10